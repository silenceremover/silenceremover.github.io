---
import type { Locale, TranslationSchema } from '../i18n/translations';
import { LOCALES } from '../i18n/translations';

interface Props {
  locale: Locale;
  t: TranslationSchema;
  currentPath?: string;
  titleOverride?: string;
  descriptionOverride?: string;
  canonicalUrlOverride?: string;
  ogType?: string;
}

const { 
  locale, 
  t, 
  currentPath = '', 
  titleOverride, 
  descriptionOverride, 
  canonicalUrlOverride,
  ogType = 'website'
} = Astro.props;

const siteUrl = 'https://silenceremover.github.io';
const canonicalUrl = canonicalUrlOverride || (locale === 'en' 
  ? `${siteUrl}/` 
  : `${siteUrl}/${locale}/`);

const metaTitle = titleOverride || t.meta.title;
const metaDescription = descriptionOverride || t.meta.description;

// High-performance Cloudinary optimized Open Graph Image
const ogImageUrl = 'https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png';

// Structured Data: WebSite, Organization, WebApplication & SoftwareApplication, FAQPage
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "SilenceRemover",
  "alternateName": ["Silence Remover", "SilenceRemover.github.io", "Audio Silence Trimmer"],
  "description": metaDescription,
  "inLanguage": locale,
  "publisher": {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "SilenceRemover",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    },
    "sameAs": [
      "https://buymeacoffee.com/kisharadilz",
      "https://github.com/silenceremover/silenceremover.github.io"
    ]
  }
};

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": ["WebApplication", "SoftwareApplication"],
  "@id": `${siteUrl}/#software`,
  "name": "SilenceRemover",
  "url": canonicalUrl,
  "description": metaDescription,
  "applicationCategory": "MultimediaApplication",
  "applicationSubCategory": "AudioEditor",
  "operatingSystem": "All modern browsers (Chrome, Edge, Firefox, Safari)",
  "browserRequirements": "Requires Web Audio API support",
  "softwareVersion": "1.0.0",
  "screenshot": ogImageUrl,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "384",
    "bestRating": "5",
    "worstRating": "1"
  },
  "featureList": [
    "100% Client-Side In-Browser Audio Processing",
    "Zero File Uploads and Absolute Voice Privacy",
    "Adjustable Silence Decibel (dB) Threshold Slider",
    "Minimum Silence Duration Slider (ms)",
    "Safety Margin (Padding) Slider for natural speech decay",
    "Intelligent Micro-Crossfade Splicing without pops or clicks",
    "Interactive Waveform Visualization with scrub and seek",
    "Studio 16-bit Lossless PCM WAV Export",
    "In-Browser MP3 Encoder Export"
  ],
  "creator": {
    "@type": "Person",
    "name": "SilenceRemover Team",
    "url": "https://buymeacoffee.com/kisharadilz"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faq.items.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<!-- Core Meta Tags -->
<title>{metaTitle}</title>
<meta name="description" content={metaDescription} />
<meta name="keywords" content={t.meta.keywords} />
<meta name="author" content="SilenceRemover" />
<link rel="canonical" href={canonicalUrl} />

<!-- Crawler Directives -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="format-detection" content="telephone=no" />

<!-- Performance Preconnect & Resource Hints for Core Web Vitals -->
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
<link rel="dns-prefetch" href="https://res.cloudinary.com" />
<link rel="preconnect" href="https://flagcdn.com" crossorigin />
<link rel="dns-prefetch" href="https://flagcdn.com" />

<!-- Theme & Mobile Settings -->
<meta name="theme-color" content="#B1B2FF" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="SilenceRemover" />

<!-- Bidirectional Hreflang Tags for all supported locales -->
<link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
{LOCALES.map((l) => (
  <link 
    rel="alternate" 
    hreflang={l.code} 
    href={l.code === 'en' ? `${siteUrl}/` : `${siteUrl}/${l.code}/`} 
  />
))}

<!-- Strict Open Graph Meta Tags -->
<meta property="og:site_name" content="SilenceRemover" />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={metaTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="SilenceRemover - Free Local Audio Silence Trimmer (100% In-Browser Privacy)" />
<meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : locale === 'es' ? 'es_ES' : locale === 'pt' ? 'pt_BR' : locale === 'de' ? 'de_DE' : locale === 'fr' ? 'fr_FR' : 'en_US'} />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={metaTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content="SilenceRemover - Free Local Audio Silence Trimmer" />

<!-- JSON-LD Structured Data: WebSite, WebApplication & SoftwareApplication, FAQPage -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
