---
import type { Locale, TranslationSchema } from '../i18n/translations';
import { LOCALES } from '../i18n/translations';

interface Props {
  locale: Locale;
  t: TranslationSchema;
}

const { locale, t } = Astro.props;

// Determine target path for each language
const getLocaleUrl = (code: Locale) => {
  return code === 'en' ? '/' : `/${code}/`;
};
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#EEF1FF]/90 dark:bg-[#0F172A]/90 border-b border-[#D2DAFF] dark:border-slate-800 transition-colors">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={getLocaleUrl(locale)} class="flex items-center gap-2 sm:gap-2.5 group">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-[#B1B2FF] to-[#AAC4FF] flex items-center justify-center shadow-xs text-slate-900 group-hover:scale-105 transition-transform shrink-0">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <!-- Audio waveform bars with a scissors cut accent -->
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M8 8v8M4 11v2M16 7v10M20 11v2" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-base sm:text-lg leading-tight tracking-tight text-slate-900 dark:text-[#EEF1FF] flex items-center gap-0.5 sm:gap-1">
          Silence<span class="text-[#8487e8] dark:text-[#B1B2FF]">Remover</span>
        </span>
        <span class="text-[9px] sm:text-[10px] uppercase font-semibold tracking-wider text-slate-500 dark:text-slate-400 hidden xs:block">100% Client-Side</span>
      </div>
    </a>

    <!-- Desktop Navigation Links (Desktop only) -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-700 dark:text-slate-300">
      <a href="/#features" class="hover:text-slate-900 dark:hover:text-[#EEF1FF] transition-colors">{t.nav.features}</a>
      <a href="/#how-it-works" class="hover:text-slate-900 dark:hover:text-[#EEF1FF] transition-colors">{t.nav.howItWorks}</a>
      <a href="/#faq" class="hover:text-slate-900 dark:hover:text-[#EEF1FF] transition-colors">{t.nav.faq}</a>
      <a href="/how-to-remove-silence-from-audio-free/" class="hover:text-slate-900 dark:hover:text-[#EEF1FF] transition-colors font-semibold text-[#8487e8] dark:text-[#B1B2FF]">Guide</a>
    </nav>

    <!-- Controls: Language, Theme & Support CTA (Icon-only on tablet & mobile) -->
    <div class="flex items-center gap-1.5 sm:gap-2 lg:gap-3">
      <!-- Language Dropdown -->
      <div class="relative group" id="lang-dropdown-wrapper">
        <button 
          id="lang-btn"
          type="button" 
          aria-label={t.nav.selectLanguage}
          title={t.nav.selectLanguage}
          class="h-9 w-9 sm:h-10 sm:w-10 lg:w-auto lg:h-10 flex items-center justify-center lg:px-3 lg:py-2 text-xs sm:text-sm font-medium rounded-xl bg-white/80 dark:bg-slate-800/80 hover:bg-[#D2DAFF] dark:hover:bg-slate-700 border border-[#D2DAFF] dark:border-slate-700 text-slate-800 dark:text-slate-200 transition-colors shadow-2xs"
        >
          <!-- Flag Icon (always visible) -->
          <span class="text-base sm:text-lg leading-none">{LOCALES.find(l => l.code === locale)?.flag}</span>
          
          <!-- Text and Chevron: hidden on tablet and mobile, visible on desktop -->
          <span class="hidden lg:inline uppercase ml-1.5 font-semibold text-xs">{locale}</span>
          <svg class="hidden lg:block w-3.5 h-3.5 ml-1 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown menu -->
        <div 
          id="lang-menu"
          class="hidden group-hover:block absolute right-0 mt-1.5 w-36 rounded-2xl bg-white dark:bg-slate-900 border border-[#D2DAFF] dark:border-slate-800 shadow-xl py-1.5 z-50 text-xs sm:text-sm animate-in fade-in zoom-in-95 duration-100"
        >
          {LOCALES.map((l) => (
            <a
              href={getLocaleUrl(l.code)}
              class={`flex items-center gap-2.5 px-3.5 py-2 text-slate-700 dark:text-slate-300 hover:bg-[#EEF1FF] dark:hover:bg-slate-800 transition-colors ${l.code === locale ? 'font-bold text-[#8487e8] dark:text-[#B1B2FF] bg-[#EEF1FF]/60 dark:bg-slate-800/60' : ''}`}
            >
              <span class="text-base">{l.flag}</span>
              <span>{l.nativeName}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Theme Switcher Button (Clean Icon-only) -->
      <button
        id="theme-toggle"
        type="button"
        aria-label={t.nav.toggleTheme}
        title={t.nav.toggleTheme}
        class="h-9 w-9 sm:h-10 sm:w-10 flex items-center justify-center rounded-xl bg-white/80 dark:bg-slate-800/80 hover:bg-[#D2DAFF] dark:hover:bg-slate-700 border border-[#D2DAFF] dark:border-slate-700 text-slate-700 dark:text-slate-200 transition-colors shadow-2xs"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="theme-sun" class="w-4 h-4 sm:w-4.5 sm:h-4.5 hidden dark:block text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="theme-moon" class="w-4 h-4 sm:w-4.5 sm:h-4.5 block dark:hidden text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Prominent "Support the Developer" CTA (Icon-only on tab & mobile, full text on desktop) -->
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.nav.support}
        title={t.nav.support}
        class="h-9 w-9 sm:h-10 sm:w-10 lg:w-auto lg:h-10 flex items-center justify-center lg:px-4 lg:py-2 rounded-xl font-bold text-xs sm:text-sm bg-[#B1B2FF] hover:bg-[#AAC4FF] text-slate-900 shadow-sm transition-all transform active:scale-95 duration-150"
      >
        <!-- Coffee cup icon (always visible) -->
        <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4v-2z"/>
        </svg>
        <!-- Text label: hidden on tablet and mobile, visible on desktop -->
        <span class="hidden lg:inline ml-2">{t.nav.support}</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Theme toggle script
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('sr-theme', isDark ? 'dark' : 'light');
    });
  }

  // Mobile touch toggle for lang dropdown
  const langBtn = document.getElementById('lang-btn');
  const langMenu = document.getElementById('lang-menu');
  if (langBtn && langMenu) {
    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      langMenu.classList.toggle('hidden');
    });
    document.addEventListener('click', () => {
      if (!langMenu.classList.contains('hidden')) {
        langMenu.classList.add('hidden');
      }
    });
  }
</script>
