  "image": ogImageUrl,
  "totalTime": "PT2M",
  "estimatedCost": {
    "@type": "MonetaryAmount",
    "currency": "USD",
    "value": "0"
  },
  "tool": [
    {
      "@type": "HowToTool",
      "name": "SilenceRemover (Free In-Browser Audio Silence Trimmer)"
    },
    {
      "@type": "HowToTool",
