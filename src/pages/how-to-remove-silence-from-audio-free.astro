      "item": canonicalUrl
    }
  ]
};

const guideFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How can I remove silence from an audio file for free without installing software?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can use SilenceRemover directly in your web browser. Drag and drop your audio file (MP3, WAV, M4A, etc.), choose your silence threshold in decibels, and click Trim Silence. The tool runs 100% client-side with zero server uploads and no account required."
      }
    },
    {
      "@type": "Question",
